[node name="Label" type="Label" parent="VBoxContainer/TabContainer/TabHelp/HBoxContainer/TabContainer/PageHelpMP/HBoxContainer" unique_id=1433646215]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
size_flags_horizontal = 3
text = "Mortar and Pestle can be accessed from the inventory. drag an item from the inventory onto the mortar to add it to the mortar. Click on an item in the mortar to remove it. press the check mark button to begin crafting.

To begin the minigame, press the \"Start\" button and use the arrow keys on the screen or the keyboard to input motions.

There are 2 main motions: crush and grind.
Crush by going up and down twice.
Grind by going left and right twice.
If you do the inputs correctly, an icon will appear to represent the motion.

When 5 motions are made, if the process matches a possible recipe for the item, a new item will be produced and added to the inventory. "
autowrap_mode = 3

[node name="PageHelpCauldron" type="MarginContainer" parent="VBoxContainer/TabContainer/TabHelp/HBoxContainer/TabContainer" unique_id=921884514]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10
metadata/_tab_index = 4

[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer/TabContainer/TabHelp/HBoxContainer/TabContainer/PageHelpCauldron" unique_id=92527875]
layout_mode = 2

[node name="TextureRect" type="TextureRect" parent="VBoxContainer/TabContainer/TabHelp/HBoxContainer/TabContainer/PageHelpCauldron/HBoxContainer" unique_id=1811678527]
layout_mode = 2
texture = ExtResource("41_vmjhy")
stretch_mode = 5

[node name="Label" type="Label" parent="VBoxContainer/TabContainer/TabHelp/HBoxContainer/TabContainer/PageHelpCauldron/HBoxContainer" unique_id=1394352297]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
size_flags_horizontal = 3
text = "Items can be added to the cauldron from the inventory. Drag an item onto the cauldron to add it to the cauldron.

When at least one item is in the cauldron, the crafting minigame can begin by pressing the check mark button on the cauldron. This opens a minigame window which shows the ingrediends that were added to the cauldron in the inventory as well as a fire icon representing bellows.

The minigame begins by pressing the \"start\" button. there will be a short countdown before the progress bar at the bottom will begin moving. The minigame works by adding an ingredient or using the bellows at a marked time interval until the process is complete. This can be done by either pressing the icons with the ingredients or bellows or pressing the hotkeys.

Once the progress hits the end of the bar, any produced item(s) will be added to the inventory."
autowrap_mode = 3

