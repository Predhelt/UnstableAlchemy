layout_mode = 2
size_flags_horizontal = 3
text = "The merger combines certain items together to produce a new item. This works by dragging items from the inventory onto the merger icon.

Pressing the check mark when two or three items are in the merger will combine them and place the result in your inventory after a short crafting time. The items can be removed from the merger by pressing on them."
autowrap_mode = 3

