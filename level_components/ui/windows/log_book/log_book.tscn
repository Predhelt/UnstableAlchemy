[node name="Label" type="RichTextLabel" parent="VBoxContainer/TabContainer/TabBooks/HBoxContainer/PageContainer/PageBookShrinkPotion" unique_id=2102844388]
layout_mode = 2
size_flags_vertical = 3
text = "Changing someone’s size can pose some questions: Do my clothes change with me? Are the changes proportional across all body parts? Is this reversible?

Luckily, the answer to all of these questions is yes, if you follow the procedure properly."

[node name="PageBookHerbFlakes" type="MarginContainer" parent="VBoxContainer/TabContainer/TabBooks/HBoxContainer/PageContainer" unique_id=1542519705]
