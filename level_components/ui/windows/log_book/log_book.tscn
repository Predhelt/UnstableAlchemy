metadata/_tab_index = 4

[node name="Label" type="RichTextLabel" parent="VBoxContainer/TabContainer/TabBooks/HBoxContainer/PageContainer/PageBookPossessionPotion" unique_id=2083759547]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 20
theme_override_font_sizes/bold_font_size = 20
theme_override_font_sizes/bold_italics_font_size = 20
theme_override_font_sizes/italics_font_size = 20
theme_override_font_sizes/mono_font_size = 20
bbcode_enabled = true
text = "The use of possession potions is sometimes considered divisive in certain tribes. However, most criticism is nullified by the fact that the possessee must consent to the possession in order for the effect to work. The feeling is often described as getting a knock on the door and needing to invite someone in.

[b]Scholars occasionally cooperate with workers to use the knowledge of the scholar in the body of the worker to perform certain tasks directly without concern for miscommunication.[/b]

Most refrain from using possession in favor of improving communications, as the intrusive nature of possession can be unsettling."

