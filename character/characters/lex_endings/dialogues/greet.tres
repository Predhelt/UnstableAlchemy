[resource]
script = ExtResource("3_icyhq")
dialogue_name = &"greet"
text = "Congratulations on collecting the crystal! In its current form, it is unstable.  Based on our discoveries, this seems to be what caused the desctruction of the village outside this cave. The folks must not have realized how dangerous this material can be when not handled properly.

Let's take this back with us and lock it away so that something like this doesn't happen again."
choices = Array[ExtResource("1_cqrba")]([SubResource("Resource_cqrba"), SubResource("Resource_4tawm")])
metadata/_custom_type_script = "uid://3qs2s64uenyc"
