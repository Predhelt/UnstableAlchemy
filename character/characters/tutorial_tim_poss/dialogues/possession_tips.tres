[resource]
script = ExtResource("3_pxshg")
dialogue_name = &"possession tips"
text = "Possession can get complicated but try to remember:
Anything you do is tied to the posessee (That's them).
Anything you know or learn is tied to the possessor (That's you).

Here are some other tips if you get stuck:
Different characters may have different strengths. Even then, they may still need to craft items or potions to push their limits.
You can craft while possessing someone, but you cannot give items to other characters. They have to acquire the materials themselves.
Not everyone is possessable, like me. I won't let you.

I might have missed something, the log book might have more info."
choices = Array[ExtResource("1_8qroq")]([SubResource("Resource_7aenp"), SubResource("Resource_rhyfb")])
metadata/_custom_type_script = "uid://3qs2s64uenyc"
