[resource]
script = ExtResource("3_icyhq")
dialogue_name = &"greet"
text = "Congratulations on collecting the geode! In its current form, it is unstable.  Based on our discoveries, this seems to be what caused the desctruction of the village outside this cave. The folks must not have realized how dangerous this material can be when not handled properly.

Let's take this back with us and lock it away so that something like this doesn't happen again. Unless you figured out how to stabilize it?"
choices = Array[ExtResource("1_cqrba")]([SubResource("Resource_4tawm")])
