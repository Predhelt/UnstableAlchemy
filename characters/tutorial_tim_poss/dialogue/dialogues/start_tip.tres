[resource]
script = ExtResource("3_vuu5k")
dialogue_name = &"start tip"
text = "You can get started by talking to the others to figure out what their strengths are, and what they can trade with you.

This puzzle can be completed without re-loading, but requires effecient use of resources to do so.

Pay attention to if a potion is \"Weak\" or not. It may act differently from regular or strong potions.

You can push boulders with enough strength.
You can weigh down plates with boulders, or use multiple people or objects.
Some doors require multiple plates of the same color to be pressed to open."
choices = Array[ExtResource("1_dwxk2")]([SubResource("Resource_7aenp"), SubResource("Resource_rhyfb")])
metadata/_custom_type_script = "uid://3qs2s64uenyc"
