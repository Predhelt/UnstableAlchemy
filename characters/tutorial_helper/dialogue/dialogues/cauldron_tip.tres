[resource]
script = ExtResource("2_ok6bn")
dialogue_name = &"cauldron tip"
text = "The first thing you are going to want to do when using the cauldron is to make sure that you have the right ingredients. If part of the procedure uses fire, that's the bellows. It's part of your cauldron kit, you don't need to add it as an ingredient.

Once you press start, the cauldron will begin crafting. All you have to do is put the proper ingredient in at the right time. Once you use an ingredient, it can't be used again for the rest of the craft.

Bonus tip: If you want to change the cauldron's craft speed or difficulty to your liking, look in the settings."
choices = Array[ExtResource("1_c3bme")]([SubResource("Resource_7aenp"), SubResource("Resource_ok6bn")])
metadata/_custom_type_script = "uid://3qs2s64uenyc"
